<Window x:Class="DeskNotepad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeskNotepad"
        mc:Ignorable="d"
        Title="MainWindow" Height="478" Width="530"
        WindowStyle="SingleBorderWindow"
        Background="White"
        Topmost="False">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="BorderBrush" Value="#999999"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="RichTextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0,10,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="25*"/>
            <RowDefinition Height="427*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110*"/>
            <ColumnDefinition Width="58*"/>
            <ColumnDefinition Width="70*"/>
            <ColumnDefinition Width="139*"/>
            <ColumnDefinition Width="143*"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="3" Content="Open" HorizontalAlignment="Center" VerticalAlignment="Center" Width="117" Height="24"
                Click="Open_Click" x:Name="OpenButton"/>

        <RadioButton Grid.Column="4" Content="Fix" HorizontalAlignment="Left" Margin="16,0,0,0" VerticalAlignment="Center" Height="16" Width="85"
                     Click="FixButton_Click" x:Name="FixRadio"/>

        <TabControl Grid.ColumnSpan="5" Margin="0,25,0,0" RenderTransformOrigin="0.5,0.5" Grid.RowSpan="2" x:Name="MainTabControl">
            <TabControl.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <RotateTransform/>
                </TransformGroup>
            </TabControl.RenderTransform>
            <TabItem Header="filename" Margin="-2,-2,-12,0" RenderTransformOrigin="0.5,0.5" x:Name="SampleTab">
                <TabItem.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </TabItem.RenderTransform>
                <Grid Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38*"/>
                        <RowDefinition Height="351*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="49*"/>
                        <ColumnDefinition Width="61*"/>
                        <ColumnDefinition Width="83*"/>
                        <ColumnDefinition Width="32*"/>
                        <ColumnDefinition Width="32*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="3" Content="Delete" HorizontalAlignment="Center" Height="22" VerticalAlignment="Center" Width="60"
                            Click="DeleteButton_Click" x:Name="DeleteButton"/>
                    <Button Grid.Column="4" Content="Close" HorizontalAlignment="Left" Margin="1,0,0,0" VerticalAlignment="Center" Width="58" Height="22"
                            Click="CloseTabButton_Click"/>
                    <TextBox HorizontalAlignment="Center" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="120" Grid.Column="1" Height="22"
                             x:Name="FileNameTextBox" TextChanged="FileNameTextBox_TextChanged"/>
                    <Label Content="File Name" HorizontalAlignment="Center" VerticalAlignment="Center" Width="78" Height="26" FontWeight="SemiBold"/>
                    <RichTextBox Grid.Row="1" Grid.ColumnSpan="5" x:Name="MainRichTextBox" TextChanged="RichTextBox_TextChanged"
                                 VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
        </TabControl>

        <ComboBox Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="58" Height="22" x:Name="FileTypeCombo" SelectedIndex="0">
            <ComboBoxItem Content="text" Foreground="Black"/>
        </ComboBox>

        <Button Content="New" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="110" Height="24" Click="New_Click"/>
    </Grid>
</Window>